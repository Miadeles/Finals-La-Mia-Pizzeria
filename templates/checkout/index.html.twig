
{% extends 'base.html.twig' %}

{% block title %}Checkout | La Mia Pizzeria{% endblock %}

{% block body %}
<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">
        <header class="dashboard-header">
            <h1>Checkout</h1>
            <p>Enter your details to complete your pizza order.</p>
        </header>

        <section class="checkout-section">
            <form id="checkout-form" enctype="multipart/form-data">

                {# ORDER TYPE: ADMIN AND STAFF ONLY #}
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                    <div class="checkout-card">
                        <h2>Order Type</h2>

                        <label for="order-type">
                            How are you placing this order?
                        </label>

                        <select id="order-type" name="orderType">
                            <option value="personal">Personal Order</option>
                            <option value="staff_assisted">
                                Phone / Message Order (For a Customer)
                            </option>
                            <option value="walk_in">
                                Walk-in Order (In-store Customer)
                            </option>
                        </select>

                        <p id="order-type-note" class="payment-note">
                            This order will be placed under your own account.
                        </p>
                    </div>
                {% endif %}

                <div class="checkout-card">
                    <h2>Customer Information</h2>

                    <label for="customer-name">Full Name</label>
                    <input
                        id="customer-name"
                        name="name"
                        type="text"
                        autocomplete="name"
                        value="{{ user ? (user.firstName ~ ' ' ~ user.lastName)|trim : '' }}"
                        required
                    >

                    <label for="customer-phone">Contact Number</label>
                    <input
                        id="customer-phone"
                        name="phone"
                        type="tel"
                        autocomplete="tel"
                        value="{{ user ? user.phoneNumber|default('') : '' }}"
                        required
                    >

                    <div id="customer-address-group">
                        <label for="customer-address">Delivery Address</label>
                        <textarea
                            id="customer-address"
                            name="address"
                            autocomplete="street-address"
                            rows="3"
                            required
                        >{{ user ? user.deliveryAddress|default('') : '' }}</textarea>
                    </div>

                    <p id="walk-in-address-note" class="payment-note" hidden>
                        No delivery address is needed for an in-store order.
                    </p>

                    {% if user %}
                        <p class="profile-shortcut">
                            Need to update your details?
                            <a href="{{ path('app_profile') }}">Go to My Account</a>
                        </p>
                    {% endif %}
                </div>

                <div class="checkout-card">
                    <h2>Payment Method</h2>

                    <label for="payment-method">Choose how you want to pay</label>

                    <select id="payment-method" name="paymentMethod" required>
                        <option value="">-- Select Payment Method --</option>
                        <option id="cash-payment-option" value="COD">
                            Cash on Delivery (COD)
                        </option>
                        <option value="GoTyme">GoTyme</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                    </select>

                    <div id="gotyme-details" class="payment-details" hidden>
                        <h3>Pay using GoTyme</h3>
                        <p>Scan the QR code below to make your payment.</p>

                        <img
                            src="{{ asset('images/gotyme-qr.jpg') }}"
                            alt="La Mia Pizzeria GoTyme QR Code"
                            class="payment-qr"
                        >

                        <p class="payment-note">
                            After paying, enter your account name and
                            reference number, then upload your payment receipt.
                        </p>
                    </div>

                    <div id="bank-details" class="payment-details" hidden>
                        <h3>Bank Transfer Details</h3>

                        <p><strong>Bank:</strong> BPI</p>
                        <p><strong>Account Name:</strong> La Mia Pizzeria</p>
                        <p><strong>Account Number:</strong> 1995-2006-2006</p>

                        <p class="payment-note">
                            After completing your bank transfer, enter the sender's
                            account name and payment reference number, then
                            upload your payment receipt.
                        </p>
                    </div>

                    <div id="online-payment-fields" hidden>
                        <label for="payment-account-name">
                            Sender's Account Name
                        </label>
                        <input
                            type="text"
                            id="payment-account-name"
                            name="paymentAccountName"
                        >

                        <label for="payment-reference">
                            Payment Reference Number
                        </label>
                        <input
                            type="text"
                            id="payment-reference"
                            name="paymentReferenceNumber"
                        >

                        <label for="payment-receipt">
                            Upload Payment Receipt
                        </label>
                        <input
                            type="file"
                            id="payment-receipt"
                            name="paymentReceipt"
                            accept="image/jpeg,image/png,image/webp,application/pdf"
                        >

                        <small class="file-help">
                            Accepted formats: JPG, PNG, WebP, or PDF. Maximum 5 MB.
                        </small>
                    </div>

                    <p class="payment-note">
                        Online payments will remain Pending until an
                        administrator or staff member verifies the payment.
                    </p>
                </div>

                <div class="checkout-card">
                    <h2>Order Summary</h2>

                    <div id="checkout-items"></div>

                    <div class="checkout-total">
                        <span>Total</span>
                        <strong id="checkout-total">₱0.00</strong>
                    </div>
                </div>

                <p id="checkout-message" role="status"></p>

                <button type="submit" class="place-order-button">
                    Place Order
                </button>

            </form>
        </section>
    </main>
</div>

<style>
.dashboard-header {
    margin-bottom: 30px;
}

.dashboard-header h1 {
    margin: 0 0 8px;
    color: #fff;
    font-size: 30px;
}

.dashboard-header p {
    margin: 0;
    color: #a8a8a8;
}

.checkout-section {
    max-width: 800px;
}

.checkout-card {
    margin-bottom: 20px;
    padding: 25px;
    background: #181818;
    border: 1px solid #292929;
    border-radius: 10px;
}

.checkout-card h2 {
    margin: 0 0 20px;
    color: #fff;
    font-size: 20px;
}

.checkout-card h3 {
    color: #e6bd70;
    margin-top: 20px;
}

.checkout-card label {
    display: block;
    margin: 16px 0 8px;
    color: #ddd;
}

.checkout-card input,
.checkout-card textarea,
.checkout-card select {
    box-sizing: border-box;
    width: 100%;
    padding: 12px;
    background: #242424;
    border: 1px solid #444;
    border-radius: 6px;
    color: #fff;
    font: inherit;
}

#customer-address-group[hidden],
#walk-in-address-note[hidden] {
    display: none;
}

.payment-details {
    margin-top: 22px;
    padding: 20px;
    background: #222;
    border: 1px solid #444;
    border-radius: 8px;
    color: #ddd;
}

.payment-qr {
    display: block;
    width: 100%;
    max-width: 280px;
    height: auto;
    margin: 20px auto;
    padding: 10px;
    background: #fff;
    border-radius: 8px;
}

.payment-note {
    display: block;
    margin-top: 8px;
    color: #bbb;
    font-size: 14px;
    line-height: 1.6;
}

.file-help {
    display: block;
    margin-top: 8px;
    color: #aaa;
}

.checkout-line {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 12px 0;
    border-bottom: 1px solid #333;
    color: #ddd;
}

.checkout-total {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
    color: #fff;
    font-size: 20px;
}

.checkout-total strong {
    color: #66bb6a;
}

.profile-shortcut {
    margin: 14px 0 0;
    color: #aaa;
    font-size: 14px;
}

.profile-shortcut a {
    color: #e6bd70;
    text-decoration: none;
    font-weight: bold;
}

.profile-shortcut a:hover {
    text-decoration: underline;
}

.place-order-button {
    padding: 13px 22px;
    background: #66bb6a;
    border: none;
    border-radius: 6px;
    color: #111;
    font-weight: bold;
    cursor: pointer;
}

.place-order-button:hover {
    background: #81c784;
}

.place-order-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

#checkout-message {
    color: #ffcc80;
}
</style>

<script>
(function () {
    const CART_KEY = 'pizzaCart';

    function initializeCheckout() {
        const itemsContainer = document.getElementById('checkout-items');
        const totalElement = document.getElementById('checkout-total');
        const message = document.getElementById('checkout-message');
        const form = document.getElementById('checkout-form');
        const orderType = document.getElementById('order-type');

        const customerName = document.getElementById('customer-name');
        const customerPhone = document.getElementById('customer-phone');
        const customerAddress = document.getElementById('customer-address');
        const addressGroup = document.getElementById('customer-address-group');
        const walkInAddressNote = document.getElementById('walk-in-address-note');
        const orderTypeNote = document.getElementById('order-type-note');
        const cashPaymentOption = document.getElementById('cash-payment-option');

        const originalName = customerName.value;
        const originalPhone = customerPhone.value;
        const originalAddress = customerAddress.value;

        function updateOrderType() {
            const type = orderType ? orderType.value : 'personal';
            const isWalkIn = type === 'walk_in';
            const isAssisted = type === 'staff_assisted';

            addressGroup.hidden = isWalkIn;
            walkInAddressNote.hidden = !isWalkIn;
            customerAddress.required = !isWalkIn;
            customerAddress.disabled = isWalkIn;

            if (cashPaymentOption) {
                cashPaymentOption.textContent = isWalkIn
                    ? 'Cash (In-store)'
                    : 'Cash on Delivery (COD)';
            }

            if (orderTypeNote) {
                orderTypeNote.textContent = isWalkIn
                    ? 'Enter the in-store customer details. A delivery address is not needed.'
                    : isAssisted
                        ? 'Enter the phone or message customer details below.'
                        : 'This order will be placed under your own account.';
            }
        }

        if (orderType) {
            orderType.addEventListener('change', function () {
                if (orderType.value === 'personal') {
                    customerName.value = originalName;
                    customerPhone.value = originalPhone;
                    customerAddress.value = originalAddress;
                } else {
                    customerName.value = '';
                    customerPhone.value = '';
                    customerAddress.value = '';
                }

                updateOrderType();
            });
        }

        updateOrderType();

        if (!itemsContainer || !totalElement || !form) {
            return;
        }

        const paymentMethod = document.getElementById('payment-method');
        const gotymeDetails = document.getElementById('gotyme-details');
        const bankDetails = document.getElementById('bank-details');
        const onlineFields = document.getElementById('online-payment-fields');

        const accountName = document.getElementById('payment-account-name');
        const referenceNumber = document.getElementById('payment-reference');
        const receipt = document.getElementById('payment-receipt');

        function updatePaymentDetails() {
            const method = paymentMethod.value;
            const isGoTyme = method === 'GoTyme';
            const isBank = method === 'Bank Transfer';
            const isOnline = isGoTyme || isBank;

            gotymeDetails.hidden = !isGoTyme;
            bankDetails.hidden = !isBank;
            onlineFields.hidden = !isOnline;

            accountName.required = isOnline;
            referenceNumber.required = isOnline;
            receipt.required = isOnline;

            accountName.disabled = !isOnline;
            referenceNumber.disabled = !isOnline;
            receipt.disabled = !isOnline;
        }

        paymentMethod.addEventListener('change', updatePaymentDetails);
        updatePaymentDetails();

        function getCart() {
            try {
                const cart = JSON.parse(
                    localStorage.getItem(CART_KEY) || '[]'
                );

                return Array.isArray(cart) ? cart : [];
            } catch (error) {
                return [];
            }
        }

        function money(amount) {
            return '₱' + amount.toLocaleString('en-PH', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function renderSummary() {
            const cart = getCart();
            itemsContainer.replaceChildren();

            let total = 0;

            if (cart.length === 0) {
                itemsContainer.textContent =
                    'Your cart is empty. Please add pizzas before checkout.';

                totalElement.textContent = money(0);
                form.querySelector('button[type="submit"]').disabled = true;
                return;
            }

            cart.forEach(function (item) {
                const quantity = Math.max(
                    1,
                    Number(item.quantity) || 1
                );

                const price = Math.max(
                    0,
                    Number(item.price) || 0
                );

                const lineTotal = price * quantity;
                total += lineTotal;

                const line = document.createElement('div');
                line.className = 'checkout-line';

                const description = document.createElement('span');
                description.textContent =
                    (item.name || 'Pizza') + ' (' +
                    (item.size || 'Size not specified') +
                    ') × ' + quantity;

                const amount = document.createElement('strong');
                amount.textContent = money(lineTotal);

                line.append(description, amount);
                itemsContainer.appendChild(line);
            });

            totalElement.textContent = money(total);

            form.querySelector('button[type="submit"]').disabled =
                total <= 0;
        }

        renderSummary();

        window.addEventListener('pageshow', renderSummary);

        window.addEventListener('storage', function (event) {
            if (event.key === CART_KEY || event.key === null) {
                renderSummary();
            }
        });

        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) {
                renderSummary();
            }
        });

        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            const cart = getCart();

            if (cart.length === 0) {
                message.textContent =
                    'Your cart is empty. Please add a pizza first.';
                renderSummary();
                return;
            }

            if (!form.reportValidity()) {
                return;
            }

            if (
                receipt.files.length > 0 &&
                receipt.files[0].size > 5 * 1024 * 1024
            ) {
                message.textContent =
                    'Your receipt must be 5 MB or smaller.';
                return;
            }

            const button = form.querySelector('button[type="submit"]');

            button.disabled = true;
            message.textContent = 'Submitting your order...';

            try {
                const formData = new FormData(form);

                formData.append('items', JSON.stringify(cart));

                const response = await fetch('/checkout', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(
                        result.message || 'Unable to place your order.'
                    );
                }

                message.textContent =
                    result.message + ' Order number: ' + result.orderId;

                localStorage.removeItem(CART_KEY);

                form.reset();
                updateOrderType();
                updatePaymentDetails();
                renderSummary();

            } catch (error) {
                message.textContent =
                    error.message ||
                    'Something went wrong. Please try again.';

            } finally {
                renderSummary();
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener(
            'DOMContentLoaded',
            initializeCheckout,
            { once: true }
        );
    } else {
        initializeCheckout();
    }
})();
</script>

{% endblock %}
