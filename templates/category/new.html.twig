
{% extends 'base.html.twig' %}

{% block title %}Create New Category | La Mia Pizzeria{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .category-new-container {
            max-width: 850px;
            margin: 0 auto;
            padding: 0 0 30px;
        }

        .category-new-title {
            color: #ffffff;
            font-size: 32px;
            font-weight: 600;
            margin: 0 0 8px;
        }

        .category-new-description {
            color: #aaaaaa;
            margin-bottom: 25px;
        }

        .category-new-card {
            background: #1b1b1b;
            border: 1px solid #333333;
            border-radius: 12px;
            padding: 30px;
        }

        .category-new-card label {
            display: block;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .category-new-card input,
        .category-new-card .form-control {
            display: block;
            width: 100%;
            box-sizing: border-box;
            background: #2b2b2b;
            color: #ffffff;
            border: 1px solid #484848;
            border-radius: 6px;
            padding: 12px 14px;
            font-size: 15px;
            color-scheme: dark;
        }

        .category-new-card input::placeholder {
            color: #aaaaaa;
        }

        .category-new-card input:focus,
        .category-new-card .form-control:focus {
            background: #2b2b2b;
            color: #ffffff;
            border-color: #b91c1c;
            outline: 2px solid #b91c1c;
            outline-offset: 1px;
            box-shadow: none;
        }

        .category-new-card .btn-success,
        .category-new-card button[type="submit"] {
            background: #b91c1c;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 12px 22px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .category-new-card .btn-success:hover,
        .category-new-card button[type="submit"]:hover {
            background: #991b1b;
            color: #ffffff;
        }

        .category-new-card .invalid-feedback,
        .category-new-card .form-error-message,
        .category-new-card ul {
            color: #f87171;
        }

        .category-new-actions {
            display: flex;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .category-new-cancel,
        .category-new-cancel:visited {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #333333;
            color: #ffffff;
            border: 1px solid #555555;
            border-radius: 6px;
            padding: 12px 22px;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
        }

        .category-new-cancel:hover {
            background: #444444;
            color: #ffffff;
            text-decoration: none;
        }

        @media (max-width: 650px) {
            .category-new-card {
                padding: 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">

        <div class="category-new-container">

            <h1 class="category-new-title">
                Create New Category
            </h1>

            <p class="category-new-description">
                Add a new category for your pizza products.
            </p>

            <div class="category-new-card">

                {{ include('category/_form.html.twig', {
                    'button_label': 'Save Category'
                }) }}

                <div class="category-new-actions">

                    <a href="{{ path('app_category_index') }}"
                       class="category-new-cancel">
                        Cancel
                    </a>

                </div>

            </div>

        </div>

    </main>

</div>

{% endblock %}
