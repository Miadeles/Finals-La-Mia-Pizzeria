
{% extends 'base.html.twig' %}

{% block title %}Category Details | La Mia Pizzeria{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .category-details {
            max-width: 900px;
            margin: 0 auto;
        }

        .category-details-title {
            color: #ffffff;
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .category-details-description {
            color: #aaaaaa;
            margin-bottom: 28px;
        }

        .category-details-card {
            background: #1b1b1b;
            border: 1px solid #333333;
            border-radius: 12px;
            padding: 30px;
        }

        .category-details-table {
            width: 100%;
            border-collapse: collapse;
            color: #ffffff;
        }

        .category-details-table th,
        .category-details-table td {
            padding: 18px 12px;
            text-align: left;
            border-bottom: 1px solid #383838;
        }

        .category-details-table th {
            width: 35%;
            font-weight: 600;
            color: #cccccc;
        }

        .category-details-table td {
            color: #ffffff;
            overflow-wrap: anywhere;
        }

        .category-details-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 30px;
        }

        .category-details-actions a,
        .category-details-actions button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 11px 20px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none !important;
            cursor: pointer;
        }

        .category-back-btn,
        .category-back-btn:visited {
            background: #333333;
            border: 1px solid #555555;
            color: #ffffff;
        }

        .category-back-btn:hover {
            background: #444444;
            color: #ffffff;
        }

        .category-edit-btn,
        .category-edit-btn:visited {
            background: #b91c1c;
            border: 1px solid #b91c1c;
            color: #ffffff;
        }

        .category-edit-btn:hover {
            background: #991b1b;
            color: #ffffff;
        }

        .category-details-actions form {
            display: inline-flex;
            margin: 0;
        }

        .category-details-actions form button {
            background: #dc3545;
            border: 1px solid #dc3545;
            color: #ffffff;
        }

        .category-details-actions form button:hover {
            background: #b02a37;
        }

        @media (max-width: 650px) {
            .category-details-card {
                padding: 20px;
            }

            .category-details-actions {
                justify-content: flex-start;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">

        <div class="category-details">

            <h1 class="category-details-title">
                Category Details
            </h1>

            <p class="category-details-description">
                View the information for this category.
            </p>

            <div class="category-details-card">

                <table class="category-details-table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ category.id }}</td>
                        </tr>

                        <tr>
                            <th>Category Name</th>
                            <td>{{ category.name }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="category-details-actions">

                    <a href="{{ path('app_category_index') }}"
                       class="category-back-btn">
                        Back to Categories
                    </a>

                    <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                       class="category-edit-btn">
                        Edit Category
                    </a>

                    {{ include('category/_delete_form.html.twig') }}

                </div>

            </div>

        </div>

    </main>

</div>

{% endblock %}
