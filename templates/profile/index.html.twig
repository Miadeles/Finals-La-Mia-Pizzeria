
{% extends 'base.html.twig' %}

{% block title %}My Account | La Mia Pizzeria{% endblock %}

{% block body %}
<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">
        <div class="profile-heading">
            <h1>My Account</h1>
            <p>Manage your personal information and delivery details.</p>
        </div>

        {# PROFILE UPDATE MESSAGES #}
        {% for message in app.flashes('success') %}
            <div class="profile-alert success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="profile-alert error">{{ message }}</div>
        {% endfor %}

        <section class="profile-card">
            <h2>Personal Information</h2>
            <p class="section-description">Keep your account details up to date.</p>

            <form method="post" action="{{ path('app_profile') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_profile') }}">

                <div class="profile-form-grid">
                    <div class="form-group">
                        <label for="firstName">First Name</label>
                        <input type="text" id="firstName" name="firstName"
                               value="{{ user.firstName }}" required maxlength="255">
                    </div>

                    <div class="form-group">
                        <label for="lastName">Last Name</label>
                        <input type="text" id="lastName" name="lastName"
                               value="{{ user.lastName }}" required maxlength="255">
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email"
                               value="{{ user.email }}" required maxlength="180">
                    </div>

                    <div class="form-group">
                        <label for="phoneNumber">Phone Number</label>
                        <input type="tel" id="phoneNumber" name="phoneNumber"
                               value="{{ user.phoneNumber ?? '' }}"
                               maxlength="30" placeholder="Enter your phone number">
                    </div>

                    <div class="form-group full-width">
                        <label for="deliveryAddress">Delivery Address</label>
                        <textarea id="deliveryAddress" name="deliveryAddress"
                                  rows="4"
                                  placeholder="Enter your complete delivery address">{{ user.deliveryAddress ?? '' }}</textarea>
                    </div>
                </div>

                <div class="profile-actions">
                    <button type="submit">Save Changes</button>
                </div>
            </form>
        </section>

        <section class="profile-card password-card" id="change-password">
            <h2>Change Password</h2>
            <p class="section-description">
                Update your password to keep your account secure.
            </p>

            {# PASSWORD CHANGE MESSAGES #}
            {% for message in app.flashes('password_error') %}
                <div class="profile-alert error">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('password_success') %}
                <div class="profile-alert success">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('app_profile') }}" data-turbo="false">
                <input type="hidden" name="formType" value="change_password">
                <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                <div class="password-form">
                    <div class="form-group">
                        <label for="currentPassword">Current Password</label>
                        <input type="password" id="currentPassword"
                               name="currentPassword"
                               autocomplete="current-password" required>
                    </div>

                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <input type="password" id="newPassword"
                               name="newPassword" minlength="8"
                               autocomplete="new-password" required>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm New Password</label>
                        <input type="password" id="confirmPassword"
                               name="confirmPassword" minlength="8"
                               autocomplete="new-password" required>
                    </div>
                </div>

                <div class="profile-actions">
                    <button type="submit">Update Password</button>
                </div>
            </form>
        </section>

    </main>
</div>

<style>
    .profile-heading {
        margin-bottom: 30px;
    }

    .profile-heading h1 {
        color: #fff;
        font-size: 28px;
        margin-bottom: 8px;
    }

    .profile-heading p,
    .section-description {
        color: #aaa;
        margin-bottom: 0;
    }

    .profile-card {
        max-width: 850px;
        padding: 28px;
        background: #181818;
        border: 1px solid #333;
        border-radius: 12px;
    }

    .profile-card h2 {
        color: #f5d7a1;
        font-size: 21px;
        margin-bottom: 8px;
    }

    .section-description {
        margin-bottom: 25px;
    }

    .profile-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        color: #eee;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 12px 14px;
        background: #252525;
        border: 1px solid #444;
        border-radius: 7px;
        color: #fff;
        outline: none;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: #f5d7a1;
    }

    .form-group textarea {
        resize: vertical;
    }

    .profile-actions {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }

    .profile-actions button {
        padding: 12px 25px;
        background: #8b1e1e;
        border: none;
        border-radius: 7px;
        color: #fff;
        font-weight: bold;
        cursor: pointer;
    }

    .profile-actions button:hover {
        background: #a52a2a;
    }

    .profile-alert {
        max-width: 850px;
        padding: 13px 16px;
        border-radius: 7px;
        margin-bottom: 18px;
    }

    .profile-alert.success {
        background: #183522;
        border: 1px solid #326b43;
        color: #b8efc6;
    }

    .profile-alert.error {
        background: #3a2020;
        border: 1px solid #8b1e1e;
        color: #ffb3b3;
    }

    .password-card {
        margin-top: 25px;
    }

    .password-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @media (max-width: 650px) {
        .profile-form-grid,
        .password-form {
            grid-template-columns: 1fr;
        }

        .form-group.full-width {
            grid-column: auto;
        }

        .profile-card {
            padding: 20px;
        }
    }

    #change-password {
        scroll-margin-top: 25px;
    }

</style>



<script>
    (function () {
        const passwordAnchor = '#change-password';

        function scrollToChangePassword() {
            if (window.location.hash !== passwordAnchor) {
                return;
            }

            const passwordSection = document.getElementById('change-password');

            if (!passwordSection) {
                return;
            }

            passwordSection.scrollIntoView({
                behavior: 'instant',
                block: 'start'
            });

            document.documentElement.classList.remove('password-scroll-pending');
        }

        if (window.location.hash === passwordAnchor) {
            document.documentElement.classList.add('password-scroll-pending');
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scrollToChangePassword);
        } else {
            scrollToChangePassword();
        }

        window.addEventListener('pageshow', scrollToChangePassword);
        window.addEventListener('hashchange', scrollToChangePassword);
    })();
</script>



{% endblock %}
