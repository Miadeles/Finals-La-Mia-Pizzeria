
<div class="sidebar-content">

    {# SIDEBAR LOGO #}
    <div class="sidebar-brand">
        <div class="sidebar-logo-box">
            <img
                src="{{ asset('images/la-mia-logo.png') }}"
                alt="La Mia Pizzeria Logo"
                class="sidebar-logo"
            >
        </div>
    </div>

    <nav class="sidebar-buttons">

        {# DASHBOARD: ADMIN AND STAFF #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

            <a href="{{ path('dashboard') }}"
               class="{{ app.request.attributes.get('_route') == 'dashboard' ? 'active' : '' }}">
                Dashboard
            </a>

        {% endif %}

        {# ADMIN-ONLY MANAGEMENT LINKS #}
        {% if is_granted('ROLE_ADMIN') %}

            <a href="{{ path('admin_users') }}"
               class="{{ app.request.attributes.get('_route') starts with 'admin_users' ? 'active' : '' }}">
                User Management
            </a>

            <a href="{{ path('app_product_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_product_' ? 'active' : '' }}">
                Product Management
            </a>

            <a href="{{ path('app_category_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_category_' ? 'active' : '' }}">
                Category Management
            </a>

        {% endif %}


        {# MANAGE ORDERS: ADMIN AND STAFF #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

            <a href="{{ path('admin_orders') }}"
            class="{{ app.request.attributes.get('_route') starts with 'admin_order' ? 'active' : '' }}">
                Manage Orders
            </a>

        {% endif %}

        {# GENERAL LINKS #}
        <a href="{{ path('app_home') }}"
           class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">
            Home
        </a>

        <a href="{{ path('app_story') }}"
           class="{{ app.request.attributes.get('_route') == 'app_story' ? 'active' : '' }}">
            Our Story
        </a>

        <a href="{{ path('app_menu') }}"
           class="{{ app.request.attributes.get('_route') == 'app_menu' ? 'active' : '' }}">
            Menu
        </a>

        <a href="{{ path('app_contact') }}"
           class="{{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}">
            Contact
        </a>

        <a href="{{ path('app_cart') }}"
           class="{{ app.request.attributes.get('_route') == 'app_cart' ? 'active' : '' }}">
            Cart
        </a>

        {# CUSTOMER AND STAFF ACCOUNT LINKS #}
        {% if is_granted('ROLE_USER') and not is_granted('ROLE_ADMIN') %}

            <a href="{{ path('app_my_orders') }}"
               class="{{ app.request.attributes.get('_route') == 'app_my_orders' ? 'active' : '' }}">
                My Orders
            </a>

            <a href="{{ path('app_profile') }}"
               class="{{ app.request.attributes.get('_route') == 'app_profile' ? 'active' : '' }}">
                My Account
            </a>

        {% endif %}

    </nav>

</div>
