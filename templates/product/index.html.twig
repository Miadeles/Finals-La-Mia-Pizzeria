
{% extends 'base.html.twig' %}

{% block title %}Product Management | La Mia Pizzeria{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        /* PRODUCT MANAGEMENT PAGE */
        .product-management-page {
            width: 100%;
            color: #ffffff;
        }

        /* HEADER */
        .product-management-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
            margin-bottom: 28px;
        }

        .product-management-heading {
            flex: 1;
            min-width: 0;
        }

        .product-management-title {
            font-size: 32px;
            font-weight: 600;
            color: #ffffff;
            margin: 0 0 8px;
        }

        .product-management-description {
            color: #aaaaaa;
            font-size: 15px;
            margin: 0;
        }

        /* CREATE BUTTON */
        .product-create-button,
        .product-create-button:focus {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #b91c1c;
            border: 1px solid #b91c1c;
            color: #ffffff;
            padding: 13px 20px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            flex-shrink: 0;
            text-decoration: none;
            box-shadow: none;
        }

        .product-create-button:hover {
            background: #991b1b;
            border-color: #991b1b;
            color: #ffffff;
        }

        /* TABLE CONTAINER */
        .product-table-wrapper {
            width: 100%;
            overflow-x: auto;
            border: 1px solid #333333;
            border-radius: 10px;
            background: #1b1b1b;
        }

        /* TABLE */
        .product-table {
            width: 100%;
            min-width: 900px;
            margin-bottom: 0;
            border-collapse: collapse;
            color: #ffffff;
            font-size: 14px;
        }

        .product-table thead th {
            background: #292929;
            color: #ffffff;
            padding: 16px;
            font-weight: 600;
            border-top: none;
            border-bottom: 1px solid #333333;
            white-space: nowrap;
        }

        .product-table tbody td {
            background: #1b1b1b;
            color: #ffffff;
            padding: 16px;
            vertical-align: middle;
            border-top: 1px solid #333333;
        }

        .product-table tbody tr:hover td {
            background: #242424;
        }

        .product-table td.description-cell {
            min-width: 200px;
            max-width: 300px;
            white-space: normal;
            overflow-wrap: break-word;
            line-height: 1.6;
        }

        .product-table td.product-name {
            font-weight: 600;
            white-space: nowrap;
        }

        .product-table td.product-price {
            font-weight: 600;
            white-space: nowrap;
        }

        .product-table td.product-image {
            overflow-wrap: anywhere;
        }

        /* ACTION BUTTONS */
        .product-actions {
            white-space: nowrap;
        }

        .product-actions-inner {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .product-actions-inner form {
            display: inline-flex;
            margin: 0;
        }

        .product-action-btn {
            min-width: 65px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 12px;
            border: none;
            border-radius: 5px;
            color: #ffffff !important;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none !important;
        }

        .product-show-btn {
            background: #334155;
        }

        .product-show-btn:hover {
            background: #475569;
        }

        .product-edit-btn {
            background: #b91c1c;
        }

        .product-edit-btn:hover {
            background: #991b1b;
        }

        .product-delete-btn {
            background: #7f1d1d;
            cursor: pointer;
        }

        .product-delete-btn:hover {
            background: #991b1b;
        }

        .product-empty-message {
            text-align: center;
            padding: 30px !important;
            color: #aaaaaa !important;
        }

        /* CREATE PRODUCT MODAL */
        #createProductModal .modal-dialog {
            max-width: 850px;
            margin: 24px auto;
        }

        #createProductModal .modal-content {
            background: #1b1b1b;
            color: #ffffff;
            border: 1px solid #444444;
            border-radius: 12px;
            overflow: hidden;
        }

        #createProductModal .modal-header {
            background: #242424;
            border-bottom: 1px solid #383838;
            padding: 18px 24px;
        }

        #createProductModal .modal-title {
            color: #ffffff;
            font-size: 21px;
            font-weight: 600;
        }

        #createProductModal .close {
            color: #ffffff;
            opacity: 0.8;
            text-shadow: none;
        }

        #createProductModal .close:hover {
            color: #ffffff;
            opacity: 1;
        }

        #createProductModal .modal-body {
            padding: 24px;
            max-height: calc(100vh - 190px);
            overflow-y: auto;
        }

        #createProductModal .form-group {
            margin-bottom: 18px;
        }

        #createProductModal label {
            color: #ffffff;
            font-weight: 600;
            margin-bottom: 8px;
        }

        /* DARK INPUT FIELDS */
        #createProductModal .form-control {
            width: 100%;
            background: #2a2a2a;
            color: #ffffff;
            border: 1px solid #484848;
            border-radius: 6px;
            padding: 11px 13px;
            height: auto;
            min-height: 46px;
        }

        #createProductModal .form-control::placeholder {
            color: #aaaaaa;
        }

        #createProductModal textarea.form-control {
            min-height: 90px;
            resize: vertical;
        }

        #createProductModal .form-control:focus {
            background: #2a2a2a;
            color: #ffffff;
            border-color: #b91c1c;
            box-shadow: 0 0 0 2px rgba(185, 28, 28, 0.2);
        }

        #createProductModal select.form-control option {
            background: #2a2a2a;
            color: #ffffff;
        }

        /* PRODUCT SIZE PRICES */
        #createProductModal .product-prices-title {
            color: #ffffff;
            font-size: 17px;
            font-weight: 600;
            margin: 10px 0 18px;
            padding-top: 18px;
            border-top: 1px solid #383838;
        }

        /* MODAL FOOTER */
        #createProductModal .modal-footer {
            background: #242424;
            border-top: 1px solid #383838;
            padding: 16px 24px;
            gap: 10px;
        }

        #createProductModal .product-cancel-button {
            background: #383838;
            border: 1px solid #555555;
            color: #ffffff;
            padding: 11px 22px;
            border-radius: 6px;
            font-weight: 600;
        }

        #createProductModal .product-cancel-button:hover {
            background: #484848;
            color: #ffffff;
        }

        #createProductModal .product-save-button {
            background: #b91c1c;
            border: 1px solid #b91c1c;
            color: #ffffff;
            padding: 11px 22px;
            border-radius: 6px;
            font-weight: 600;
        }

        #createProductModal .product-save-button:hover {
            background: #991b1b;
            border-color: #991b1b;
        }

        /* VALIDATION ERRORS */
        #createProductModal .invalid-feedback,
        #createProductModal .form-error-message,
        #createProductModal .modal-form-errors,
        #createProductModal .modal-form-errors ul {
            color: #f87171;
        }

        #createProductModal .modal-form-errors ul {
            padding-left: 18px;
        }

        /* RESPONSIVE DESIGN */
        @media (max-width: 650px) {
            .product-management-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }

            .product-management-title {
                font-size: 26px;
            }

            .product-create-button {
                width: 100%;
            }
        }

        @media (max-width: 768px) {
            #createProductModal .modal-dialog {
                margin: 12px;
            }

            #createProductModal .modal-body {
                padding: 18px;
                max-height: calc(100vh - 160px);
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="dashboard-container">

    {# ADMIN SIDEBAR #}
    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    {# MAIN CONTENT #}
    <main class="dashboard-content">

        <div class="product-management-page">

            {# PAGE HEADER #}
            <div class="product-management-header">

                <div class="product-management-heading">

                    <h1 class="product-management-title">
                        Product Management
                    </h1>

                    <p class="product-management-description">
                        Manage your pizza products, prices, and menu information.
                    </p>

                </div>

                <button type="button"
                        class="btn product-create-button"
                        data-toggle="modal"
                        data-target="#createProductModal">
                    + Create New Product
                </button>

            </div>

            {# SUCCESS MESSAGES #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}

            {# ERROR MESSAGES #}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">
                    {{ message }}
                </div>
            {% endfor %}

            {# PRODUCT TABLE #}
            <div class="product-table-wrapper">

                <table class="table product-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for product in products %}

                            <tr>

                                <td>
                                    {{ product.id }}
                                </td>

                                <td class="product-name">
                                    {{ product.name }}
                                </td>

                                <td class="description-cell">
                                    {{ product.description }}
                                </td>

                                <td class="product-price">
                                    ₱{{ product.price }}
                                </td>

                                <td class="product-image">
                                    {{ product.image }}
                                </td>

                                <td class="product-actions">

                                    <div class="product-actions-inner">

                                        <a href="{{ path('app_product_show', {'id': product.id}) }}"
                                           class="product-action-btn product-show-btn">
                                            Show
                                        </a>

                                        <a href="{{ path('app_product_edit', {'id': product.id}) }}"
                                           class="product-action-btn product-edit-btn">
                                            Edit
                                        </a>

                                        <form method="post"
                                              action="{{ path('app_product_delete', {'id': product.id}) }}"
                                              onsubmit="return confirm('Are you sure you want to delete this product?');">

                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('delete' ~ product.id) }}">

                                            <button type="submit"
                                                    class="product-action-btn product-delete-btn">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        {% else %}

                            <tr>
                                <td colspan="6" class="product-empty-message">
                                    No products found.
                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </main>

</div>

{# CREATE NEW PRODUCT MODAL #}
<div class="modal fade"
     id="createProductModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="createProductModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg" role="document">

        <div class="modal-content">

            {{ form_start(form, {'attr': {'id': 'createProductForm'}}) }}

                {# MODAL HEADER #}
                <div class="modal-header">

                    <h5 class="modal-title"
                        id="createProductModalLabel">
                        Create New Product
                    </h5>

                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>

                </div>

                {# MODAL BODY #}
                <div class="modal-body">

                    <div class="modal-form-errors">
                        {{ form_errors(form) }}
                    </div>

                    {# NAME AND CATEGORY #}
                    <div class="form-row">

                        <div class="form-group col-md-6">

                            {{ form_label(form.name, 'Product Name') }}

                            {{ form_widget(form.name, {
                                'attr': {'class': 'form-control'}
                            }) }}

                            <div class="modal-form-errors">
                                {{ form_errors(form.name) }}
                            </div>

                        </div>

                        <div class="form-group col-md-6">

                            {{ form_label(form.category, 'Category') }}

                            {{ form_widget(form.category, {
                                'attr': {'class': 'form-control'}
                            }) }}

                            <div class="modal-form-errors">
                                {{ form_errors(form.category) }}
                            </div>

                        </div>

                    </div>

                    {# DESCRIPTION #}
                    <div class="form-group">

                        {{ form_label(form.description, 'Description') }}

                        {{ form_widget(form.description, {
                            'attr': {
                                'class': 'form-control',
                                'rows': 3
                            }
                        }) }}

                        <div class="modal-form-errors">
                            {{ form_errors(form.description) }}
                        </div>

                    </div>

                    {# BASE PRICE AND IMAGE #}
                    <div class="form-row">

                        <div class="form-group col-md-6">

                            {{ form_label(form.price, 'Base Price (legacy)') }}

                            {{ form_widget(form.price, {
                                'attr': {'class': 'form-control'}
                            }) }}

                            <div class="modal-form-errors">
                                {{ form_errors(form.price) }}
                            </div>

                        </div>

                        <div class="form-group col-md-6">

                            {{ form_label(form.image, 'Image Filename') }}

                            {{ form_widget(form.image, {
                                'attr': {'class': 'form-control'}
                            }) }}

                            <div class="modal-form-errors">
                                {{ form_errors(form.image) }}
                            </div>

                        </div>

                    </div>

                    {# PRODUCT SIZE PRICES #}
                    <h6 class="product-prices-title">
                        Product Size Prices
                    </h6>

                    <div class="form-row">

                        <div class="form-group col-md-4">

                            {{ form_label(form.smallPrice, 'Small Price (₱)') }}

                            {{ form_widget(form.smallPrice, {
                                'attr': {'class': 'form-control'}
                            }) }}

                            <div class="modal-form-errors">
                                {{ form_errors(form.smallPrice) }}
                            </div>

                        </div>

                        <div class="form-group col-md-4">

                            {{ form_label(form.mediumPrice, 'Medium Price (₱)') }}

                            {{ form_widget(form.mediumPrice, {
                                'attr': {'class': 'form-control'}
                            }) }}

                            <div class="modal-form-errors">
                                {{ form_errors(form.mediumPrice) }}
                            </div>

                        </div>

                        <div class="form-group col-md-4">

                            {{ form_label(form.largePrice, 'Large Price (₱)') }}

                            {{ form_widget(form.largePrice, {
                                'attr': {'class': 'form-control'}
                            }) }}

                            <div class="modal-form-errors">
                                {{ form_errors(form.largePrice) }}
                            </div>

                        </div>

                    </div>

                </div>

                {# MODAL FOOTER #}
                <div class="modal-footer">

                    <button type="button"
                            class="btn product-cancel-button"
                            data-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn product-save-button">
                        Save Product
                    </button>

                </div>

            {{ form_end(form) }}

        </div>

    </div>

</div>

{% endblock %}
