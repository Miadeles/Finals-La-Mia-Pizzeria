
{% extends 'base.html.twig' %}

{% block title %}Product Details | La Mia Pizzeria{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        .product-show-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 10px 0 40px;
        }

        .product-show-header {
            margin-bottom: 28px;
        }

        .product-show-title {
            font-size: 32px;
            font-weight: 600;
            color: #ffffff;
            margin: 0 0 10px;
        }

        .product-show-description {
            color: #aaaaaa;
            margin: 0;
        }

        .product-show-card {
            background: #1b1b1b;
            border: 1px solid #333333;
            border-radius: 12px;
            padding: 30px;
        }

        .product-show-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        .product-show-table th,
        .product-show-table td {
            padding: 16px 12px;
            border-bottom: 1px solid #383838;
            vertical-align: top;
        }

        .product-show-table th {
            width: 32%;
            color: #aaaaaa;
            font-weight: 600;
            text-align: left;
        }

        .product-show-table td {
            color: #ffffff;
            overflow-wrap: anywhere;
        }

        .product-show-section-title {
            color: #ffffff;
            font-size: 21px;
            margin: 0 0 20px;
        }

        .product-price-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .product-price-card {
            background: #242424;
            border: 1px solid #3a3a3a;
            border-radius: 8px;
            padding: 22px;
            text-align: center;
        }

        .product-price-label {
            display: block;
            color: #aaaaaa;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .product-price-value {
            display: block;
            color: #ffffff;
            font-size: 23px;
            font-weight: 700;
        }

        .product-show-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .product-show-actions .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 43px;
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
        }

        .product-show-back,
        .product-show-back:hover {
            background: #333333;
            border: 1px solid #555555;
            color: #ffffff;
        }

        .product-show-edit,
        .product-show-edit:hover {
            background: #b91c1c;
            border: 1px solid #b91c1c;
            color: #ffffff;
        }

        .product-show-delete-form {
            display: inline-flex;
            margin: 0;
        }

        .product-show-delete-form button {
            min-height: 43px;
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
        }

        @media (max-width: 650px) {
            .product-show-card {
                padding: 20px;
            }

            .product-show-title {
                font-size: 27px;
            }

            .product-price-grid {
                grid-template-columns: 1fr;
            }

            .product-show-actions {
                justify-content: flex-start;
            }

            .product-show-table th {
                width: 38%;
            }
        }
    </style>
{% endblock %}

{% block body %}

<div class="dashboard-container">

    {# Keep the Admin Sidebar visible #}
    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">

        <div class="product-show-container">

            <div class="product-show-header">
                <h1 class="product-show-title">
                    Product Details
                </h1>

                <p class="product-show-description">
                    View product information and pricing.
                </p>
            </div>

            <div class="product-show-card">

                {# Product Information #}
                <table class="product-show-table">
                    <tbody>

                        <tr>
                            <th>ID</th>
                            <td>{{ product.id }}</td>
                        </tr>

                        <tr>
                            <th>Name</th>
                            <td>{{ product.name }}</td>
                        </tr>

                        <tr>
                            <th>Description</th>
                            <td>{{ product.description }}</td>
                        </tr>

                        <tr>
                            <th>Category</th>
                            <td>
                                {{ product.category ? product.category.name : 'No category' }}
                            </td>
                        </tr>

                        <tr>
                            <th>Image Filename</th>
                            <td>{{ product.image }}</td>
                        </tr>

                    </tbody>
                </table>

                {# Product Prices #}
                <h2 class="product-show-section-title">
                    Product Prices
                </h2>

                <div class="product-price-grid">

                    <div class="product-price-card">
                        <span class="product-price-label">
                            Base Price
                        </span>

                        <strong class="product-price-value">
                            ₱{{ product.price }}
                        </strong>
                    </div>

                    <div class="product-price-card">
                        <span class="product-price-label">
                            Small
                        </span>

                        <strong class="product-price-value">
                            ₱{{ product.smallPrice }}
                        </strong>
                    </div>

                    <div class="product-price-card">
                        <span class="product-price-label">
                            Medium
                        </span>

                        <strong class="product-price-value">
                            ₱{{ product.mediumPrice }}
                        </strong>
                    </div>

                    <div class="product-price-card">
                        <span class="product-price-label">
                            Large
                        </span>

                        <strong class="product-price-value">
                            ₱{{ product.largePrice }}
                        </strong>
                    </div>

                </div>

                {# Action Buttons #}
                <div class="product-show-actions">

                    <a href="{{ path('app_product_index') }}"
                       class="btn product-show-back">
                        Back to Products
                    </a>

                    <a href="{{ path('app_product_edit', {'id': product.id}) }}"
                       class="btn product-show-edit">
                        Edit Product
                    </a>

                    <div class="product-show-delete-form">
                        {{ include('product/_delete_form.html.twig') }}
                    </div>

                </div>

            </div>

        </div>

    </main>

</div>

{% endblock %}
