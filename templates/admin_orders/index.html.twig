
{% extends 'base.html.twig' %}

{% block title %}Admin Orders | La Mia Pizzeria{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .orders-container {
            max-width: 1200px;
            margin: auto;
            color: #ffffff;
        }

        .orders-container h1 {
            color: #ffffff;
        }

        .orders-container .subtitle {
            color: #a8a8a8;
        }

        .message {
            padding: 12px 16px;
            margin: 12px 0;
            border-radius: 8px;
            background: #e2f4e5;
            color: #292521;
        }

        .error {
            background: #ffe2e2;
        }

        .order {
            background: #181818;
            color: #ffffff;
            padding: 22px;
            margin: 20px 0;
            border-radius: 12px;
            border: 1px solid #292929;
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            border-bottom: 1px solid #333;
            padding-bottom: 12px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 32px;
            padding: 6px 14px;
            border-radius: 20px;
            background: #fff0cb;
            color: #292521;
            font-size: 13px;
            font-weight: bold;
            box-sizing: border-box;
        }

        .details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin: 18px 0;
        }

        .label {
            color: #a8a8a8;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .orders-container .order .items,
        .orders-container .order .items li,
        .orders-container .order .total {
            font-size: 16px !important;
            line-height: 1.8;
        }

        .orders-container .order .total {
            font-weight: bold;
            color: #ffffff;
        }

        .orders-container select,
        .orders-container button {
            min-height: 42px;
            padding: 10px 16px;
            border-radius: 7px;
            font-size: 14px;
        }

        .orders-container select {
            background: #252525;
            color: #ffffff;
            border: 1px solid #444;
        }

        .orders-container button {
            background: #8b2026;
            color: #ffffff;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s ease;
        }

        .orders-container button:hover {
            background: #6f171c;
        }

        .orders-container form {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .orders-container .order-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin: 18px 0;
        }

        .orders-container .undo-button {
            background: #555 !important;
        }

        .orders-container .undo-button:hover {
            background: #3f3f3f !important;
        }

        .orders-container .reject-button {
            background: #555 !important;
        }

        .orders-container .reject-button:hover {
            background: #3f3f3f !important;
        }

        .orders-container .delivery-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            padding-top: 16px;
            border-top: 1px solid #333;
            margin-top: 20px;
        }

        .orders-container .delivery-actions label {
            color: #cccccc;
            font-weight: 600;
        }

        .empty {
            background: #181818;
            padding: 25px;
            border-radius: 10px;
        }

        .orders-container .order .order-items-heading {
            font-size: 16px !important;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .order-type {
            display: inline-block;
            padding: 7px 12px;
            border-radius: 6px;
            background: #292929;
            border: 1px solid #444;
            color: #e6bd70;
            font-size: 13px;
            font-weight: 600;
        }

        .orders-container .order .order-type-label {
            margin-top: 14px;
        }

        @media (max-width: 600px) {
            .order {
                padding: 16px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">

    <aside class="sidebar">
        {% include 'sidebar/index.html.twig' %}
    </aside>

    <main class="dashboard-content">
        <div class="orders-container">

            <h1>La Mia Pizzeria — Admin Orders</h1>

            <p class="subtitle">
                View customer orders, verify payments, and update order status.
            </p>

            {% for message in app.flashes('success') %}
                <div class="message">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="message error">{{ message }}</div>
            {% endfor %}

            <h2>All Orders ({{ orders|length }})</h2>

            {% for order in orders %}

                {% set isWalkIn = order.orderType == 'walk_in' %}
                {% set isStaffAssisted = order.orderType == 'staff_assisted' %}
                {% set isCash = order.paymentMethod == 'COD' %}

                <section class="order">

                    <div class="order-header">
                        <h2>Order #{{ order.id }}</h2>
                        <span class="status">{{ order.status }}</span>
                    </div>

                    <div class="order-type-label">
                        <div class="label">Order Type</div>

                        <span class="order-type">
                            {% if isWalkIn %}
                                Walk-in Order (In-store)
                            {% elseif isStaffAssisted %}
                                Phone / Message Order
                            {% else %}
                                Personal Order
                            {% endif %}
                        </span>
                    </div>

                    <div class="details">

                        <div>
                            <div class="label">Customer</div>
                            <strong>{{ order.customerName }}</strong>
                        </div>

                        <div>
                            <div class="label">Phone</div>
                            {{ order.customerPhone }}
                        </div>

                        <div>
                            {% if isWalkIn %}
                                <div class="label">Fulfillment</div>
                                <strong>
                                    In-store (No delivery address required)
                                </strong>
                            {% else %}
                                <div class="label">Delivery Address</div>
                                {{ order.customerAddress ?: 'Not provided' }}
                            {% endif %}
                        </div>

                    </div>

                    <h3 class="order-items-heading">Order Items</h3>

                    <ul class="items">
                        {% for item in order.orderItems %}
                            <li>
                                {{ item.pizzaName }} — {{ item.pizzaSize }}
                                × {{ item.quantity }}
                                (₱{{ (item.price * item.quantity)|number_format(2, '.', ',') }})
                            </li>
                        {% endfor %}
                    </ul>

                    <p class="total">
                        Total: ₱{{ order.total|number_format(2, '.', ',') }}
                    </p>

                    <hr style="border-color: #333;">

                    <h3>Payment Information</h3>

                    <div class="details">

                        <div>
                            <div class="label">Payment Method</div>

                            <strong>
                                {% if isCash and isWalkIn %}
                                    Cash (In-store)
                                {% elseif isCash %}
                                    Cash on Delivery (COD)
                                {% else %}
                                    {{ order.paymentMethod }}
                                {% endif %}
                            </strong>
                        </div>

                        <div>
                            <div class="label">Payment Status</div>
                            <span class="status">
                                {{ order.paymentStatus }}
                            </span>
                        </div>

                        {% if not isCash %}

                            <div>
                                <div class="label">Sender's Account Name</div>
                                {{ order.paymentAccountName ?: 'Not provided' }}
                            </div>

                            <div>
                                <div class="label">Payment Reference Number</div>
                                {{ order.paymentReferenceNumber ?: 'Not provided' }}
                            </div>

                            <div>
                                <div class="label">Payment Receipt</div>

                                {% if order.paymentReceipt %}
                                    <a
                                        href="{{ path('admin_order_payment_receipt', {id: order.id}) }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        style="color: #e6bd70;"
                                    >
                                        View Payment Receipt
                                    </a>
                                {% else %}
                                    No receipt uploaded
                                {% endif %}
                            </div>

                        {% endif %}

                    </div>

                    <div class="order-actions">

                        {# ONLINE PAYMENT CONFIRMATION #}
                        {% if not isCash and order.paymentStatus == 'Pending' %}

                            <form
                                method="post"
                                action="{{ path('admin_order_payment_status', {id: order.id}) }}"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('update_payment_status_' ~ order.id) }}"
                                >

                                <button
                                    type="submit"
                                    name="paymentStatus"
                                    value="Paid"
                                    onclick="return confirm('Are you sure you want to mark Order #{{ order.id }} as Paid?');"
                                >
                                    Mark as Paid
                                </button>

                                <button
                                    type="submit"
                                    name="paymentStatus"
                                    value="Rejected"
                                    class="reject-button"
                                    onclick="return confirm('Are you sure you want to reject the payment for Order #{{ order.id }}?');"
                                >
                                    Reject Payment
                                </button>

                            </form>

                        {% endif %}

                        {# CASH PAYMENT CONFIRMATION #}
                        {% if isCash and order.paymentStatus == 'Pending' %}

                            <form
                                method="post"
                                action="{{ path('admin_order_payment_status', {id: order.id}) }}"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('update_payment_status_' ~ order.id) }}"
                                >

                                <button
                                    type="submit"
                                    name="paymentStatus"
                                    value="Paid"
                                    onclick="return confirm('Are you sure you have received cash payment for Order #{{ order.id }}?');"
                                >
                                    {% if isWalkIn %}
                                        Mark Cash as Paid
                                    {% else %}
                                        Mark COD as Paid
                                    {% endif %}
                                </button>

                            </form>

                        {% endif %}

                        {# UNDO PAYMENT CONFIRMATION #}
                        {% if order.paymentStatus == 'Paid' %}

                            <form
                                method="post"
                                action="{{ path('admin_order_undo_payment', {id: order.id}) }}"
                                onsubmit="return confirm('Are you sure you want to undo the payment confirmation for Order #{{ order.id }}?');"
                            >

                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('undo_payment_' ~ order.id) }}"
                                >

                                <button type="submit" class="undo-button">
                                    Undo Payment
                                </button>

                            </form>

                        {% endif %}

                    </div>

                    {# ORDER STATUS MANAGEMENT #}
                    <form
                        method="post"
                        action="{{ path('admin_order_status', {id: order.id}) }}"
                        class="delivery-actions"
                    >

                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('update_order_status_' ~ order.id) }}"
                        >

                        <label for="status-{{ order.id }}">
                            Update status:
                        </label>

                        <select id="status-{{ order.id }}" name="status">

                            {% if isWalkIn %}
                                {% set allowedStatuses = [
                                    'Pending',
                                    'Preparing',
                                    'Ready for Pickup',
                                    'Picked Up',
                                    'Cancelled'
                                ] %}
                            {% else %}
                                {% set allowedStatuses = [
                                    'Pending',
                                    'Preparing',
                                    'Out for Delivery',
                                    'Delivered',
                                    'Cancelled'
                                ] %}
                            {% endif %}

                            {% for status in allowedStatuses %}
                                <option
                                    value="{{ status }}"
                                    {% if order.status == status %}selected{% endif %}
                                >
                                    {{ status }}
                                </option>
                            {% endfor %}

                        </select>

                        <button type="submit">
                            Save Status
                        </button>

                    </form>

                </section>

            {% else %}

                <div class="empty">
                    No orders have been placed yet.
                </div>

            {% endfor %}

        </div>
    </main>
</div>
{% endblock %}
